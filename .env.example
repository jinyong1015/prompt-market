NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# Clerk user IDs (user_xxx) and/or emails, comma-separated.
# Restart the Next.js server after changing this.
CLERK_ADMIN_USER_IDS=user_xxxxxxxx,you@example.com

# Server-only. Never prefix with NEXT_PUBLIC_. Used for admin CRUD after Clerk isAdmin().
SUPABASE_SERVICE_ROLE_KEY=eyJ...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Canonical site origin (no trailing slash). Used for metadataBase, sitemap, Open Graph.
# Example: https://prompt-market.vercel.app or https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

